# Copy to .env and change every value marked CHANGE. Never commit .env.
ENV=dev
POSTGRES_PASSWORD=CHANGE
DATABASE_URL=postgresql+psycopg://flowhq:CHANGE@postgres:5432/flowhq
SECRET_KEY=CHANGE-long-random-string
# Generated with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
COOKIE_SECURE=false
# Local / open-source model through Ollama's OpenAI-compatible API.
# LLM_PROVIDER=none => instant evidence-based templates, no model needed. ollama => the model writes only the opening line.
LLM_PROVIDER=none
LLM_BASE_URL=http://host.docker.internal:11434/v1
# Fast options: qwen2.5:1.5b-instruct (fastest), qwen2.5:3b-instruct (better). Benchmark with `python -m scripts.bench_llm`.
LLM_MODEL=qwen2.5:3b-instruct
LLM_TIMEOUT_SECONDS=60
# Voice dictation (optional). none = off. openai_compat = any server exposing POST {STT_BASE_URL}/audio/transcriptions
# (a local Whisper-compatible server is recommended; a hosted provider means audio leaves your network, and the UI says so).
# Raw audio is deleted as soon as it is transcribed. Hindi/Hinglish need a bigger model than English: measure with scripts/bench_stt.py.
STT_PROVIDER=none
STT_BASE_URL=http://host.docker.internal:8001/v1
STT_MODEL=Systran/faster-whisper-small
STT_API_KEY=
STT_TIMEOUT_SECONDS=60
VOICE_MAX_SECONDS=120
VOICE_MAX_PER_HOUR=60
VOICE_RETENTION_HOURS=24
# Used in unsubscribe links: must be the public https URL of this app in production
PUBLIC_BASE_URL=http://localhost:3000
# NEVER true in production (lets the research fetcher reach localhost/private IPs)
ALLOW_PRIVATE_FETCH=false
# Ports
API_PORT=8000
WEB_PORT=3000
